# Skill-to-Career AI Engine Backend Environment Variables

# Server Port (default 5000)
PORT=5000

# MongoDB Connection String (from MongoDB Atlas or local MongoDB)
# IMPORTANT: In MongoDB Atlas Network Access, ensure 0.0.0.0/0 (allow from anywhere) is enabled for Render.
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/skill2career?retryWrites=true&w=majority
# MONGODB_URI is also supported as an alias:
# MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/skill2career?retryWrites=true&w=majority

# JWT Secret Key for token generation
JWT_SECRET=your_super_secret_jwt_key_here

# Google Gemini API Key (Get free key from https://aistudio.google.com/)
GEMINI_API_KEY=your_gemini_api_key_here
# AI_API_KEY is also supported as an alias:
# AI_API_KEY=your_gemini_api_key_here

# Node environment (development | production)
NODE_ENV=development
